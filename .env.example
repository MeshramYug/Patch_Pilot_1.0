# ==============================================================================
# PatchPilot Configuration
# ==============================================================================
# Choose your preferred provider: "gemini", "groq", "ollama", or "openai"
# Default is "gemini" if GEMINI_API_KEY is present, or "ollama" if local.
PATCH_PILOT_PROVIDER=gemini

# Google Gemini API Key (Recommended - Free Tier available)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Ultra-fast inference)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Ollama Host (For 100% free, private local execution)
# Run: ollama run qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Self-Healing Execution Settings
MAX_REPAIR_ATTEMPTS=3
SANDBOX_TIMEOUT_SECONDS=15
